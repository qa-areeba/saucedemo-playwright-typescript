{
  "name": "enterprise-qa-automation-platform",
  "version": "1.0.0",
  "description": "Playwright and TypeScript test automation framework with Page Object Model, custom fixtures, data-driven tests, multi-browser runs and GitHub Actions CI",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:chromium": "playwright test --project=Chromium",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "page-object-model",
    "github-actions"
  ],
  "author": "Areeba Zakir",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "allure-playwright": "^3.10.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
